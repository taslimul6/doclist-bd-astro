PUBLIC_SITE_URL=https://doclist-bd.com

# First batch: 30 main pages (60 bilingual URLs) at 00:00 Asia/Dhaka. Optional override (wrangler `vars`).
DOCLIST_RELEASE_START=2026-10-18

# Engagement storage: the D1 binding `DB` (wrangler.jsonc) is used on Cloudflare.
# Optional alternative: Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
