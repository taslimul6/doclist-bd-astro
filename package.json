{
  "name": "doclist-bd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "wrangler dev",
    "typecheck": "astro check",
    "data:normalize": "python3 scripts/import-national.py",
    "test": "node scripts/build-doctor-merges.mjs --check && node scripts/build-index-rollout.mjs --check && node scripts/test-index-rollout.mjs && node scripts/test-directory.mjs && node scripts/test-preferences.mjs && node scripts/test-interactions.mjs && node scripts/test-publication.mjs",
    "test:http": "python3 scripts/smoke-test.py",
    "test:engagement": "python3 scripts/test-engagement-http.py",
    "test:dates": "node scripts/test-page-dates.mjs",
    "test:images": "python3 scripts/test-doctor-images.py",
    "test:seo": "node scripts/test-seo.mjs",
    "data:import": "python3 scripts/import-national.py",
    "test:import": "python3 scripts/test-national-import.py",
    "test:national-http": "python3 scripts/test-national-http.py",
    "schedule:refresh": "python3 scripts/generate-release-schedule.py",
    "test:publication": "node scripts/test-publication.mjs",
    "test:publication-http": "python3 scripts/test-publication-http.py",
    "data:merges": "node scripts/build-doctor-merges.mjs",
    "seo:rollout": "node scripts/build-index-rollout.mjs",
    "test:rollout": "node scripts/test-index-rollout.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply doclist-engagement --remote",
    "db:migrate:local": "wrangler d1 migrations apply doclist-engagement --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wrangler": "^4.168.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "workerd@1.20261123.1": true,
    "esbuild@0.28.2": true
  }
}
