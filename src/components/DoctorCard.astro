---
import ReleaseLink from './ReleaseLink.astro';
import DoctorAvatar from './DoctorAvatar.astro';
import DoctorBadges from './DoctorBadges.astro';
import SaveDoctor from './SaveDoctor';
import DoctorEngagement from './DoctorEngagement';
import {isPublished} from '../../lib/publication';
import {phoneHref} from '../../lib/utils';
import type {Doctor} from '../../lib/types';
import {getSpecialtyBySlug} from '../../lib/directory';
import {type Locale,t,localizedPath,specialty,medicalText,provider,schedule,num,pick,institution} from '../../lib/i18n';
const {doctor,hospitalSlug,locationSlug,lang}=Astro.props as {doctor:Doctor;hospitalSlug?:string;locationSlug?:string;lang:Locale};
const visible=isPublished('/doctor/'+doctor.slug);
const c=doctor.chambers.find(c=>(!hospitalSlug||c.hospitalSlug===hospitalSlug)&&(!locationSlug||c.locations.includes(locationSlug)))||doctor.chambers[0];
const url=(p:string)=>localizedPath(lang,p);
---
{visible&&<article class={"card doctor-card list card-hover"+(doctor.featured?" is-featured":"")}><DoctorAvatar doctor={doctor}/><div class="doctor-main"><DoctorBadges featured={doctor.featured} verified={doctor.verified} lang={lang}/><h3><ReleaseLink href={url('/doctor/'+doctor.slug)} lang="en">{doctor.name}</ReleaseLink></h3><div class="specialty">{doctor.specialtySlugs.slice(0,3).map(s=>specialty(lang,getSpecialtyBySlug(s)?.name||'')).filter(Boolean).join(' · ')||medicalText(lang,doctor.rawSpecialties[0]||'Doctor')}</div>{doctor.qualifications&&<div class="qualifications">{medicalText(lang,doctor.qualifications)}</div>}{doctor.designation&&<div class="designation">{institution(lang,doctor.designation)}</div>}<div class="meta-row">{doctor.experience!==null&&<span>{pick(lang,`${num(lang,doctor.experience)} years of experience`,`${num(lang,doctor.experience)} বছরের অভিজ্ঞতা`)}</span>}{c&&<ReleaseLink href={url('/hospital/'+c.hospitalSlug)}>{provider(lang,c.name)}</ReleaseLink>}{doctor.chambers.length>1&&<span>{pick(lang,`${num(lang,doctor.chambers.length)} chambers`,`${num(lang,doctor.chambers.length)}টি চেম্বার`)}</span>}</div>{c?.schedule&&<p class="schedule">{schedule(lang,c.schedule)}</p>}</div><div class="doctor-actions"><SaveDoctor client:idle id={doctor.id} lang={lang}/><DoctorEngagement client:visible id={doctor.id} slug={doctor.slug} name={doctor.name} lang={lang}/>{c?.fee&&<div class="fee"><strong>৳{num(lang,Number(c.fee))}</strong><span>{t(lang,'Listed consultation fee')}</span></div>}<ReleaseLink class="btn btn-secondary" href={url('/doctor/'+doctor.slug)}>{t(lang,'View Profile')}</ReleaseLink>{c?.phone&&<ReleaseLink class="btn btn-primary" href={phoneHref(c.phone)}>{t(lang,'Call Chamber')}</ReleaseLink>}{c&&<ReleaseLink class="btn btn-soft" href={url('/hospital/'+c.hospitalSlug)}>{t(lang,'View Hospital')}</ReleaseLink>}</div></article>}
