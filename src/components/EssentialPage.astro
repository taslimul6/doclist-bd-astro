---
import {type Locale,pick,localizedPath} from '../../lib/i18n';
import {essentialContent,type EssentialPageKey,contactEmail,contactPhone,whatsappUrl} from '../../lib/essential-pages';
import Breadcrumbs from './Breadcrumbs.astro';
const {page,lang}=Astro.props as {page:EssentialPageKey;lang:Locale};
const c=essentialContent(page,lang),contact=page==='contact'||page==='sponsorship';
---
<section class="page-hero"><div class="container"><Breadcrumbs lang={lang} items={[{label:c.title}]}/><h1>{c.title}</h1><p>{c.description}</p></div></section><section class="section"><div class="container essential-content"><div class="stack">{c.sections.map(s=><section class="content-card"><h2>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}{contact?<section class="content-card"><h2>{pick(lang,'Email & WhatsApp','ইমেইল ও WhatsApp')}</h2><p><strong>{pick(lang,'Email: ','ইমেইল: ')}</strong><a href={'mailto:'+contactEmail}>{contactEmail}</a></p><p><strong>WhatsApp: </strong><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" lang="en">{contactPhone}</a></p><div class="contact-actions"><a class="btn btn-primary" href={'mailto:'+contactEmail}>{pick(lang,'Send Email','ইমেইল করুন')}</a><a class="btn btn-secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">{pick(lang,'Chat on WhatsApp','WhatsApp-এ কথা বলুন')}</a></div></section>:<p class="small"><a href={localizedPath(lang,'/contact')}>{pick(lang,'Contact us','আমাদের সঙ্গে যোগাযোগ করুন')}</a></p>}</div></div></section>
