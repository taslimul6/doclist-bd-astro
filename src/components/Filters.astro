---
import ReleaseLink from './ReleaseLink.astro';
import GeographyFields from './GeographyFields';
import {specialties,locations,hospitals,doctors,value} from '../../lib/directory';
import type {Query,ListingContext} from '../../lib/types';
import {type Locale,t,pick,specialty,provider,num} from '../../lib/i18n';
const {query,context,lang}=Astro.props as {query:Query;context:ListingContext;lang:Locale};
type Opt={slug:string;name:string};
const selects:{name:string;label:string;options:Opt[];display:(n:string)=>string}[]=[];
if(!context.specialty)selects.push({name:'specialty',label:'Specialties',options:specialties,display:n=>specialty(lang,n)});
const showHospital=!context.hospital;
const hospitalSelect={name:'hospital',label:'Hospitals',options:hospitals as Opt[],display:(n:string)=>provider(lang,n)};
const genderSelect={name:'gender',label:'Gender',options:[{slug:'male',name:'Male'},{slug:'female',name:'Female'}],display:(n:string)=>t(lang,n)};
const showGender=doctors.some(d=>d.gender);
const showFee=doctors.some(d=>d.chambers.some(c=>c.fee));
const initialDivision=value(query,'division')||(()=>{const l=locations.find(l=>l.slug===(value(query,'district')||value(query,'location')));return l?.kind==='division'?l.slug:l?.kind==='area'?locations.find(d=>d.slug===l.parent)?.parent||'':l?.parent||'';})();
const loc=context.location;
const fixedDivision=loc?.kind==='division'?loc.slug:loc?.kind==='district'?loc.parent||'':loc?.kind==='area'?locations.find(l=>l.slug===loc.parent)?.parent||'':'';
const fixedDistrict=loc?.kind==='district'?loc.slug:loc?.kind==='area'?loc.parent||'':'';
const geoOptions=locations.map(({slug,name,kind,parent})=>({slug,name,kind,parent}));
const sel=(s:{name:string;label:string;options:Opt[];display:(n:string)=>string})=>s;
---
<details class="filter-panel" open><summary>{t(lang,'Refine your search')}</summary><form action={context.path} method="get" class="filters card">
<div class="filter-group field"><label for="filter-q">{t(lang,'Search')}</label><input id="filter-q" name="q" value={value(query,'q')} placeholder={t(lang,'Name, hospital or keyword')} maxlength={200}/></div>
{selects.map(s=><div class="filter-group field"><label for={'filter-'+s.name}>{t(lang,s.label)}</label><select id={'filter-'+s.name} name={s.name}><option value="">{pick(lang,'All '+s.label.toLowerCase(),'সব '+t(lang,s.label))}</option>{s.options.map(o=><option value={o.slug} selected={value(query,s.name)===o.slug}>{s.display(o.name)}</option>)}</select></div>)}
<GeographyFields client:load lang={lang} options={geoOptions} initialDivision={initialDivision} initialDistrict={value(query,'district')||value(query,'location')} fixedDivision={fixedDivision} fixedDistrict={fixedDistrict}/>
{showHospital&&(()=>{const s=sel(hospitalSelect);return <div class="filter-group field"><label for={'filter-'+s.name}>{t(lang,s.label)}</label><select id={'filter-'+s.name} name={s.name}><option value="">{pick(lang,'All '+s.label.toLowerCase(),'সব '+t(lang,s.label))}</option>{s.options.map(o=><option value={o.slug} selected={value(query,s.name)===o.slug}>{s.display(o.name)}</option>)}</select></div>;})()}
<div class="filter-group field"><label for="filter-exp">{t(lang,'Minimum experience')}</label><select id="filter-exp" name="experience"><option value="">{t(lang,'Any experience')}</option>{[5,10,15].map(n=><option value={n} selected={value(query,'experience')===String(n)}>{pick(lang,`${n}+ years (where listed)`,`${num(lang,n)}+ বছর (তথ্য থাকলে)`)}</option>)}</select></div>
{showGender&&(()=>{const s=sel(genderSelect);return <div class="filter-group field"><label for={'filter-'+s.name}>{t(lang,s.label)}</label><select id={'filter-'+s.name} name={s.name}><option value="">{pick(lang,'All '+s.label.toLowerCase(),'সব '+t(lang,s.label))}</option>{s.options.map(o=><option value={o.slug} selected={value(query,s.name)===o.slug}>{s.display(o.name)}</option>)}</select></div>;})()}
{showFee&&<div class="filter-group field"><label for="filter-fee">{t(lang,'Maximum fee (BDT)')}</label><input id="filter-fee" type="number" min="0" name="maxFee" value={value(query,'maxFee')}/></div>}
<div class="filter-group field"><label for="filter-sort">{t(lang,'Sort by')}</label><select id="filter-sort" name="sort"><option value="">{t(lang,'Directory order')}</option><option value="name" selected={value(query,'sort')==='name'}>{t(lang,'Name A–Z')}</option><option value="experience" selected={value(query,'sort')==='experience'}>{t(lang,'Listed experience')}</option></select></div>
<button class="btn btn-primary" type="submit">{t(lang,'Apply Filters')}</button><ReleaseLink class="reset-link" href={context.path}>{t(lang,'Clear filters')}</ReleaseLink></form></details>
