---
import ReleaseLink from './ReleaseLink.astro';
import Preferences from './Preferences';
import {type Locale,t,localizedPath} from '../../lib/i18n';
const {lang,pathname}=Astro.props as {lang:Locale;pathname:string};
const nav=[['Home','/'],['Doctors','/doctors'],['Specialties','/specialties'],['Hospitals','/hospitals'],['Locations','/locations'],['Saved Docs','/my-doc']];
---
<header class="site-header"><div class="topbar"><div class="container"><span>{t(lang,'Bangladesh Doctor Directory')}</span><span>{t(lang,'Confirm appointments directly with the chamber')}</span></div></div><div class="container nav-wrap"><ReleaseLink class="brand" href={localizedPath(lang,'/')}><span class="brand-mark" aria-hidden="true">+</span><span>Doclist Bd<small>{t(lang,'Bangladesh')}</small></span></ReleaseLink><nav class="main-nav" aria-label={t(lang,'Navigation menu')}>{nav.map(([label,href])=><ReleaseLink href={localizedPath(lang,href)}>{t(lang,label)}</ReleaseLink>)}</nav><Preferences client:load lang={lang} pathname={pathname}/><details class="mobile-menu"><summary aria-label={t(lang,'Navigation menu')}>☰</summary><nav aria-label={t(lang,'Navigation menu')}>{nav.map(([label,href])=><ReleaseLink href={localizedPath(lang,href)}>{t(lang,label)}</ReleaseLink>)}</nav></details></div></header>
