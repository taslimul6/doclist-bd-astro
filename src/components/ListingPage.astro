---
import ReleaseLink from './ReleaseLink.astro';
import PageDates from './PageDates.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Filters from './Filters.astro';
import DoctorCard from './DoctorCard.astro';
import Pagination from './Pagination.astro';
import RelatedLinks from './RelatedLinks.astro';
import SEOContent from './SEOContent.astro';
import Schema from './Schema.astro';
import {searchDoctors,pageSize} from '../../lib/directory';
import {absolute} from '../../lib/seo';
import type {Query,ListingContext} from '../../lib/types';
import {type Locale,t,pick,num,localizedPath} from '../../lib/i18n';
// The page runs `searchDoctors` first (to answer 404 for an invalid page) and passes the result in.
const {context:c,query,lang,result,baseCount}=Astro.props as {context:ListingContext;query:Query;lang:Locale;result:ReturnType<typeof searchDoctors>;baseCount:number};
---
<PageDates path={c.path} lang={lang}/><section class="page-hero"><div class="container"><Breadcrumbs lang={lang} items={c.breadcrumbs||[{label:t(lang,'Doctors')},{label:c.title}]}/><span class="eyebrow">{t(lang,'Doctor Directory')}</span><h1>{c.title}</h1><p>{c.description}</p><div class="seo-stats"><div class="seo-stat"><strong>{num(lang,baseCount)}</strong>{t(lang,'Doctor profiles')}</div><div class="seo-stat"><strong>{t(lang,'Chambers & schedules')}</strong>{t(lang,'Compare available details')}</div></div></div></section><div class="container section"><div class="page-layout"><Filters lang={lang} query={query} context={c}/><div><div class="toolbar"><p class="count" aria-live="polite">{result.total?pick(lang,`Showing ${(result.page-1)*pageSize+1}–${Math.min(result.page*pageSize,result.total)} of ${result.total} doctors`,`মোট ${num(lang,result.total)} জনের মধ্যে ${num(lang,(result.page-1)*pageSize+1)}–${num(lang,Math.min(result.page*pageSize,result.total))} জন দেখানো হচ্ছে`):t(lang,'No matching doctors')}</p><span class="small">{pick(lang,`Page ${result.page} of ${result.pages}`,`পৃষ্ঠা ${num(lang,result.page)} / ${num(lang,result.pages)}`)}</span></div><div class="stack">{result.items.map(d=><DoctorCard lang={lang} doctor={d} hospitalSlug={c.hospital?.slug} locationSlug={c.location?.slug}/>)}{!result.total&&<div class="content-card empty-state"><h2>{t(lang,'No matching doctors')}</h2><p>{t(lang,'Try a different keyword or clear your filters.')}</p><ReleaseLink class="btn btn-primary" href={c.path}>{t(lang,'Reset Search')}</ReleaseLink></div>}</div><Pagination lang={lang} path={c.path} query={query} page={result.page} pages={result.pages}/></div></div><div class="stack after-list"><SEOContent lang={lang} context={c} count={baseCount}/><RelatedLinks lang={lang} context={c}/></div></div><Schema data={{'@type':'CollectionPage',inLanguage:lang==='bn'?'bn-BD':'en-BD',name:c.title,url:absolute(c.path+(result.page>1?'?page='+result.page:'')),description:c.description,mainEntity:{'@type':'ItemList',numberOfItems:result.total,itemListElement:result.items.map((d,i)=>({'@type':'ListItem',position:(result.page-1)*pageSize+i+1,url:absolute(localizedPath(lang,'/doctor/'+d.slug)),name:d.name}))}}}/>
