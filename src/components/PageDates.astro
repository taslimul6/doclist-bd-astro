---
import {absolute} from '../../lib/seo';
import {type Locale,localizedPath} from '../../lib/i18n';
// Historical synthetic dates are intentionally not exposed as publication facts.
const {path,lang}=Astro.props as {path:string;lang:Locale};
const url=absolute(localizedPath(lang,path.replace(/^\/(bn|en)(?=\/|$)/,'')||'/'));
const json=JSON.stringify({'@context':'https://schema.org','@type':'WebPage','@id':url+'#webpage',url,inLanguage:lang==='bn'?'bn-BD':'en-BD'}).replace(/</g,'\u003c');
---
<script type="application/ld+json" is:inline set:html={json}></script>
