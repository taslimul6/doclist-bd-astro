---
import ReleaseLink from './ReleaseLink.astro';
import {getRelatedLocations,getRelatedSpecialties,hospitals,hospitalSpecialty} from '../../lib/directory';
import type {ListingContext} from '../../lib/types';
import {type Locale,t,localizedPath,specialty,place,provider,specialtyLocationTitle} from '../../lib/i18n';
const {context:c,lang}=Astro.props as {context:ListingContext;lang:Locale};
const s=c.specialty?.slug,l=c.location?.slug,h=c.hospital?.slug;
const nearby=getRelatedLocations(s,l),related=getRelatedSpecialties(l,s,h);
const hs=hospitals.filter(x=>(!l||x.locations.includes(l))&&(!s||!!hospitalSpecialty[x.slug+'/'+s])).slice(0,5);
---
<section class="link-groups" aria-label={lang==='bn'?'সম্পর্কিত ডিরেক্টরি':'Related directories'}><div class="link-panel"><h3>{t(lang,s?'This specialty by location':'Browse locations')}</h3>{nearby.map(x=><ReleaseLink href={localizedPath(lang,s?'/doctors/'+s+'/'+x.slug:'/doctors/'+x.slug)}>{s?specialtyLocationTitle(lang,c.specialty!.name,x.name):place(lang,x.name)}</ReleaseLink>)}</div><div class="link-panel"><h3>{t(lang,'Related specialties')}</h3>{related.map(x=><ReleaseLink href={localizedPath(lang,h?'/hospital/'+h+'/'+x.slug:l?'/doctors/'+x.slug+'/'+l:'/specialty/'+x.slug)}>{l?specialtyLocationTitle(lang,x.name,c.location!.name):specialty(lang,x.name)}</ReleaseLink>)}</div><div class="link-panel"><h3>{t(lang,'Hospital doctor lists')}</h3>{hs.map(x=><ReleaseLink href={localizedPath(lang,'/hospital/'+x.slug+(s?'/'+s:'/doctors'))}>{provider(lang,x.name)}</ReleaseLink>)}</div></section>
