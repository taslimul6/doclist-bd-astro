---
import Layout from '../../layouts/Layout.astro';
import ReleaseLink from '../../components/ReleaseLink.astro';
import PageDates from '../../components/PageDates.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HospitalCard from '../../components/HospitalCard.astro';
import Pagination from '../../components/Pagination.astro';
import {hospitals,value,pageSize,getLocationBySlug,getSpecialtyBySlug,hospitalSpecialty} from '../../../lib/directory';
import {metadata} from '../../../lib/seo';
import {queryFrom} from '../../../lib/utils';
import {getLocale} from '../../../lib/locale';
import {t,pick,num,localizedPath,provider,address} from '../../../lib/i18n';

const lang=getLocale(Astro.params.lang);
if(!lang)return Astro.rewrite('/404');
const q=queryFrom(Astro.url.searchParams);
const meta=metadata(pick(lang,'Hospitals & Clinics in Bangladesh','বাংলাদেশের হাসপাতাল ও ক্লিনিক'),pick(lang,'Browse hospitals, clinics and diagnostic centres and their doctor lists.','হাসপাতাল, ক্লিনিক ও ডায়াগনস্টিক সেন্টারের ডাক্তার তালিকা ও যোগাযোগের তথ্য দেখুন।'),'/hospitals',q,lang);
const term=value(q,'q').toLowerCase(),location=getLocationBySlug(value(q,'location')),sp=getSpecialtyBySlug(value(q,'specialty'));
const list=hospitals.filter(h=>(h.name+' '+h.addresses.join(' ')+' '+provider('bn',h.name)+' '+h.addresses.map(a=>address('bn',a)).join(' ')).toLowerCase().includes(term)&&(!value(q,'location')||(!!location&&h.locations.includes(location.slug)))&&(!value(q,'specialty')||(!!sp&&!!hospitalSpecialty[h.slug+'/'+sp.slug])));
const pages=Math.max(1,Math.ceil(list.length/pageSize)),page=Number(value(q,'page')||1);
if(!Number.isSafeInteger(page)||page<1||page>pages)return Astro.rewrite('/404');
const path=localizedPath(lang,'/hospitals');
---
<Layout lang={lang} meta={meta}>
<PageDates path="/hospitals" lang={lang}/><section class="page-hero"><div class="container"><Breadcrumbs lang={lang} items={[{label:t(lang,'Hospitals')}]}/><h1>{pick(lang,'Hospitals & Clinics in Bangladesh','বাংলাদেশের হাসপাতাল ও ক্লিনিক')}</h1><p>{pick(lang,`Browse ${hospitals.length} listed providers and their doctor directories.`,`${num(lang,hospitals.length)}টি তালিকাভুক্ত প্রতিষ্ঠান ও তাদের ডাক্তার তালিকা দেখুন।`)}</p><form action={path} class="hospital-search" method="get"><label class="field">{t(lang,'Hospital or address')}<input name="q" value={value(q,'q')} placeholder={t(lang,'Search hospitals')} maxlength={200}/></label>{value(q,'location')&&<input type="hidden" name="location" value={value(q,'location')}/>}{value(q,'specialty')&&<input type="hidden" name="specialty" value={value(q,'specialty')}/>}<button class="btn btn-primary">{t(lang,'Search')}</button><ReleaseLink class="btn btn-secondary" href={path}>{t(lang,'Reset')}</ReleaseLink></form></div></section><section class="section"><div class="container"><p>{pick(lang,`${list.length} matching providers`,`${num(lang,list.length)}টি প্রতিষ্ঠান পাওয়া গেছে`)}</p><div class="grid grid-3">{list.slice((page-1)*pageSize,page*pageSize).map(h=><HospitalCard lang={lang} hospital={h}/>)}{!list.length&&<div class="content-card"><h2>{t(lang,'No matching hospitals')}</h2><p>{t(lang,'Try a different search term.')}</p></div>}</div><Pagination lang={lang} path={path} query={q} page={page} pages={pages}/></div></section>
</Layout>
