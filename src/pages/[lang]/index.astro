---
import Layout from '../../layouts/Layout.astro';
import ReleaseLink from '../../components/ReleaseLink.astro';
import PageDates from '../../components/PageDates.astro';
import SearchBar from '../../components/SearchBar.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import HospitalCard from '../../components/HospitalCard.astro';
import SpecialtyCard from '../../components/SpecialtyCard.astro';
import LocationCard from '../../components/LocationCard.astro';
import FAQ from '../../components/FAQ.astro';
import Schema from '../../components/Schema.astro';
import {doctors,hospitals,specialties,locations,specialtyLocation,getSpecialtyBySlug,getLocationBySlug} from '../../../lib/directory';
import audit from '../../../data/audit.json';
import {absolute,siteName,metadata} from '../../../lib/seo';
import {getLocale} from '../../../lib/locale';
import {t,pick,num,localizedPath,place,specialtyLocationTitle} from '../../../lib/i18n';

const lang=getLocale(Astro.params.lang);
if(!lang)return Astro.rewrite('/404');
const url=(p:string)=>localizedPath(lang,p);
const districts=locations.filter(l=>l.kind==='district');
const popular=['cardiology/dhaka','nephrology/dhaka','neurology/rajshahi','gynecology/chattogram'].filter(k=>specialtyLocation[k]);
const meta=metadata(pick(lang,'Find Doctors, Hospitals & Specialists in Bangladesh','বাংলাদেশের ডাক্তার, হাসপাতাল ও বিশেষজ্ঞ খুঁজুন'),pick(lang,'Search Bangladesh doctor profiles by specialty, location and hospital. Compare qualifications, chambers, available schedules and contact information.','বিশেষজ্ঞ বিভাগ, এলাকা ও হাসপাতাল অনুযায়ী বাংলাদেশের ডাক্তার খুঁজুন। যোগ্যতা, চেম্বার, সময়সূচি ও যোগাযোগের তথ্য তুলনা করুন।'),'/',{},lang);
const metrics:[number,string][]=[[doctors.length,'Doctor profiles'],[hospitals.length,'Hospitals & Clinics'],[districts.length,'Districts represented'],[audit.listingRows,'Specialty/chamber listings']];
const checklists=[['Compare the practical details','Review listed qualifications, the exact chamber address, visiting times and the appointment process.'],['Prepare your appointment','Bring previous reports, your current medication list, and a short list of symptoms and questions.'],['Confirm fees and schedules','Call the chamber before travelling. Ask about consultation fees, follow-up fees and available appointment slots.']];
---
<Layout lang={lang} meta={meta}>
<PageDates path="/" lang={lang}/>
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">{t(lang,'Healthcare discovery across Bangladesh')}</span><h1>{t(lang,'Find the Right Doctor Near You')}</h1><p>{t(lang,'Search by specialty, location, hospital or clinic. Compare doctor qualifications and chamber details in one place.')}</p><div class="hero-points">{['Browse specialties','Compare chamber details','Contact providers directly'].map(s=><span>✓ {t(lang,s)}</span>)}</div></div><div class="hero-card"><div class="trust-card">{metrics.map(([count,label])=><div class="metric"><strong>{num(lang,Number(count))}</strong><span>{t(lang,label)}</span></div>)}<div class="note-card"><h3>{t(lang,'Plan your visit with confidence')}</h3><p>{t(lang,'Check the listed qualifications and chambers, then call the provider to confirm appointments and fees.')}</p></div></div></div></div><div class="container"><SearchBar lang={lang}/><div class="search-examples"><strong>{t(lang,'Popular searches')}:</strong>{popular.map(k=>{const [s,l]=k.split('/');return <ReleaseLink href={url('/doctors/'+k)}>{specialtyLocationTitle(lang,getSpecialtyBySlug(s)!.name,getLocationBySlug(l)!.name)}</ReleaseLink>;})}</div></div></section>
<section class="section section-white"><div class="container"><div class="section-heading"><div><span class="eyebrow">{t(lang,'Browse by care')}</span><h2>{t(lang,'Popular Specialties')}</h2><p>{t(lang,'Start with the care you need, then narrow by location or hospital.')}</p></div><ReleaseLink class="btn btn-secondary" href={url('/specialties')}>{t(lang,'View all specialties')}</ReleaseLink></div><div class="grid grid-4">{specialties.slice(0,12).map(s=><SpecialtyCard lang={lang} specialty={s}/>)}</div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">{t(lang,'Browse by place')}</span><h2>{t(lang,'Doctors by Location')}</h2><p>{t(lang,'Explore the districts represented in the directory.')}</p></div><ReleaseLink class="btn btn-secondary" href={url('/locations')}>{t(lang,'All locations')}</ReleaseLink></div><div class="grid grid-4">{districts.map(l=><LocationCard lang={lang} location={l}/>)}</div><div class="content-card after-list"><h3>{t(lang,'Browse local areas')}</h3><div class="district-cloud">{locations.filter(l=>l.kind==='area').map(l=><ReleaseLink href={url('/doctors/'+l.slug)}>{place(lang,l.name)}</ReleaseLink>)}</div></div></div></section>
<section class="section section-white"><div class="container"><div class="section-heading"><div><span class="eyebrow">{t(lang,'Explore profiles')}</span><h2>{t(lang,'Meet Doctors in the Directory')}</h2><p>{t(lang,'Read qualifications and choose a chamber that works for you.')}</p></div><ReleaseLink class="btn btn-secondary" href={url('/doctors')}>{t(lang,'Browse all doctors')}</ReleaseLink></div><div class="stack">{doctors.slice(0,3).map(d=><DoctorCard lang={lang} doctor={d}/>)}</div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">{t(lang,'Find a provider')}</span><h2>{t(lang,'Hospitals & Diagnostic Centres')}</h2></div><ReleaseLink class="btn btn-secondary" href={url('/hospitals')}>{t(lang,'View hospital directory')}</ReleaseLink></div><div class="grid grid-3">{hospitals.slice(0,6).map(h=><HospitalCard lang={lang} hospital={h}/>)}</div></div></section>
<section class="section section-white"><div class="container"><div class="section-heading"><div><span class="eyebrow">{t(lang,'Before your visit')}</span><h2>{t(lang,'Useful Patient Checklists')}</h2></div></div><div class="grid grid-3">{checklists.map(([h,p])=><article class="card"><h3>{t(lang,h)}</h3><p>{t(lang,p)}</p></article>)}</div></div></section>
<section class="section"><div class="container"><FAQ lang={lang}/></div></section>
<Schema data={{'@type':'WebSite',name:siteName,inLanguage:lang==='bn'?'bn-BD':'en-BD',url:absolute(url('/')),potentialAction:{'@type':'SearchAction',target:{'@type':'EntryPoint',urlTemplate:absolute(url('/doctors')+'?q={search_term_string}')},'query-input':'required name=search_term_string'}}}/>
</Layout>
