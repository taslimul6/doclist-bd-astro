---
import Layout from '../../layouts/Layout.astro';
import PageDates from '../../components/PageDates.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LocationCard from '../../components/LocationCard.astro';
import {locations} from '../../../lib/directory';
import {metadata} from '../../../lib/seo';
import {getLocale} from '../../../lib/locale';
import {t,pick} from '../../../lib/i18n';

const lang=getLocale(Astro.params.lang);
if(!lang)return Astro.rewrite('/404');
const meta=metadata(pick(lang,'Doctors by District, Division and Area','জেলা, বিভাগ ও এলাকা অনুযায়ী ডাক্তার'),pick(lang,'Explore Bangladesh doctor listings by district, division and local area.','জেলা, বিভাগ ও স্থানীয় এলাকা অনুযায়ী বাংলাদেশের ডাক্তার তালিকা দেখুন।'),'/locations',{},lang);
const kinds=['district','division','area'];
---
<Layout lang={lang} meta={meta}>
<PageDates path="/locations" lang={lang}/><section class="page-hero"><div class="container"><Breadcrumbs lang={lang} items={[{label:t(lang,'Locations')}]}/><h1>{t(lang,'Find Doctors by Location')}</h1><p>{t(lang,'Browse locations represented in the current dataset. Counts reflect distinct doctor profiles.')}</p></div></section>
{kinds.map(kind=><section class="section"><div class="container"><div class="section-heading"><h2>{t(lang,kind==='district'?'Districts':kind==='division'?'Divisions':'Local Areas')}</h2></div><div class="grid grid-4">{locations.filter(l=>l.kind===kind).map(l=><LocationCard lang={lang} location={l}/>)}</div></div></section>)}
</Layout>
