---
import Layout from '../../layouts/Layout.astro';
import MyDoctors from '../../components/MyDoctors';
import {getLocale} from '../../../lib/locale';

const lang=getLocale(Astro.params.lang);
if(!lang)return Astro.rewrite('/404');
const title=lang==='en'?'Saved Docs':'আমার ডাক্তার';
const meta={title,description:undefined,robots:{index:false,follow:true}};
---
<Layout lang={lang} meta={meta}>
<section class="page-hero"><div class="container"><h1>{title}</h1><p>{lang==='en'?'Your personal doctor list. Saved on this browser for 365 days from each save. Clearing browser data removes this list; it does not sync to other devices.':'আপনার ব্যক্তিগত ডাক্তার তালিকা। সেভ করার পর ৩৬৫ দিন এই ব্রাউজারে থাকবে। ব্রাউজারের ডেটা মুছলে তালিকা মুছে যাবে; অন্য ডিভাইসে তালিকা পাওয়া যাবে না।'}</p></div></section><section class="section"><div class="container"><MyDoctors client:load lang={lang}/></div></section>
</Layout>
