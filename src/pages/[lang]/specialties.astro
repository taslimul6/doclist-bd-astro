---
import Layout from '../../layouts/Layout.astro';
import PageDates from '../../components/PageDates.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SpecialtyCard from '../../components/SpecialtyCard.astro';
import {specialties} from '../../../lib/directory';
import {metadata} from '../../../lib/seo';
import {getLocale} from '../../../lib/locale';
import {t,pick,num} from '../../../lib/i18n';

const lang=getLocale(Astro.params.lang);
if(!lang)return Astro.rewrite('/404');
const meta=metadata(pick(lang,'Medical Specialties in Bangladesh','বাংলাদেশের চিকিৎসার বিশেষজ্ঞ বিভাগ'),pick(lang,'Browse medical specialties and compare doctors, locations and chambers.','চিকিৎসার বিশেষজ্ঞ বিভাগ বেছে নিয়ে ডাক্তার, এলাকা ও চেম্বারের তথ্য তুলনা করুন।'),'/specialties',{},lang);
---
<Layout lang={lang} meta={meta}>
<PageDates path="/specialties" lang={lang}/><section class="page-hero"><div class="container"><Breadcrumbs lang={lang} items={[{label:t(lang,'Specialties')}]}/><h1>{t(lang,'Find Doctors by Specialty')}</h1><p>{pick(lang,`${specialties.length} specialty categories represented in public doctor listings.`,`প্রকাশ্য ডাক্তার তালিকা থেকে ${num(lang,specialties.length)}টি বিশেষজ্ঞ বিভাগ।`)}</p></div></section><section class="section"><div class="container grid grid-4">{specialties.map(s=><SpecialtyCard lang={lang} specialty={s}/>)}</div></section>
</Layout>
