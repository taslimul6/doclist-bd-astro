---
import type {Locale} from '../../lib/i18n';
import Layout from '../layouts/Layout.astro';
import ReleaseLink from '../components/ReleaseLink.astro';
import PageDates from '../components/PageDates.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DoctorBadges from '../components/DoctorBadges.astro';
import DoctorAvatar from '../components/DoctorAvatar.astro';
import DoctorCard from '../components/DoctorCard.astro';
import ChamberCard from '../components/ChamberCard.astro';
import FAQ from '../components/FAQ.astro';
import Schema from '../components/Schema.astro';
import SaveDoctor from '../components/SaveDoctor';
import ShareDoctor from '../components/ShareDoctor';
import {getDoctorBySlug,getSpecialtyBySlug,getLocationBySlug,getRelatedDoctors,specialtyLocation} from '../../lib/directory';
import {metadata,absolute} from '../../lib/seo';
import {phoneHref} from '../../lib/utils';
import {t,pick,place,specialty,provider,medicalText,schedule,institution,address,num,localizedPath,specialtyLocationTitle} from '../../lib/i18n';

const {lang,a:slug}=Astro.props as {lang:Locale;a:string};
const d=getDoctorBySlug(slug)!;

const url=(path:string)=>localizedPath(lang,path);
const district=d.locationSlugs.map(getLocationBySlug).find(l=>l?.kind==='district');
const city=district?place(lang,district.name):pick(lang,'Bangladesh','বাংলাদেশ');
const specialtyNames=d.specialtySlugs.map(k=>specialty(lang,getSpecialtyBySlug(k)?.name||'')).filter(Boolean).slice(0,3).join(', ');
const meta=metadata(d.name+' — '+(specialtyNames||pick(lang,'Doctor Profile','ডাক্তারের প্রোফাইল'))+' — '+city,pick(lang,`View ${d.name}'s qualifications, ${city} chamber addresses, ${d.chambers.length} chambers, schedules and appointment contact information.`,`${d.name}-এর যোগ্যতা, ${city}-এর চেম্বারের ঠিকানা, ${num(lang,d.chambers.length)}টি চেম্বার, সময়সূচি ও অ্যাপয়েন্টমেন্টের যোগাযোগের তথ্য দেখুন।`),'/doctor/'+d.slug,{},lang);
const related=getRelatedDoctors(d),first=d.chambers[0];
const faqs=[d.chambers.some(c=>c.address)&&{q:pick(lang,`Where does ${d.name} see patients?`,`${d.name} কোথায় রোগী দেখেন?`),a:d.chambers.filter(c=>c.address).map(c=>provider(lang,c.name)+' — '+address(lang,c.address)).join('; ')},first?.phone&&{q:pick(lang,`How can I book an appointment with ${d.name}?`,`${d.name}-এর অ্যাপয়েন্টমেন্ট কীভাবে নেব?`),a:pick(lang,`Call the listed chamber number, ${first.phone}, and confirm the current schedule and appointment process. Other chamber contacts are shown above when available.`,`তালিকাভুক্ত চেম্বার নম্বর ${first.phone}-এ কল করে বর্তমান সময়সূচি ও অ্যাপয়েন্টমেন্টের নিয়ম নিশ্চিত করুন। অন্যান্য চেম্বারের যোগাযোগের তথ্য থাকলে উপরে দেখানো হয়েছে।`)},d.chambers.some(c=>c.schedule)&&{q:pick(lang,`When does ${d.name} see patients?`,`${d.name} কখন রোগী দেখেন?`),a:d.chambers.filter(c=>c.schedule).map(c=>provider(lang,c.name)+': '+schedule(lang,c.schedule)).join('; ')},d.qualifications&&{q:pick(lang,`What are ${d.name}'s listed qualifications?`,`${d.name}-এর তালিকাভুক্ত যোগ্যতা কী?`),a:medicalText(lang,d.qualifications)}].filter((x):x is {q:string;a:string}=>!!x);
const lastChecked=d.lastChecked?new Intl.DateTimeFormat(lang==='bn'?'bn-BD':'en-BD',{dateStyle:'long',timeZone:'UTC'}).format(new Date(d.lastChecked+'T00:00:00Z')):'';
---
<Layout lang={lang} meta={meta}>
<PageDates path={'/doctor/'+d.slug} lang={lang}/>
<section class="profile-hero"><div class="container"><Breadcrumbs lang={lang} items={[{label:t(lang,'Doctors'),href:url('/doctors')},...(district?[{label:place(lang,district.name),href:url('/doctors/'+district.slug)}]:[]),{label:d.name}]}/><div class="profile-head"><DoctorAvatar doctor={d} large/><div class="profile-info"><DoctorBadges featured={d.featured} verified={d.verified} lang={lang}/><h1 lang="en">{d.name}</h1><div class="specialty">{d.specialtySlugs.map(s=><ReleaseLink class="pill brand" href={url('/specialty/'+s)}>{specialty(lang,getSpecialtyBySlug(s)?.name||'')}</ReleaseLink>)}</div>{d.qualifications&&<p class="qualifications">{medicalText(lang,d.qualifications)}</p>}{d.designation&&<p class="designation">{institution(lang,d.designation)}</p>}{d.institute&&<p>{institution(lang,d.institute)}</p>}<ShareDoctor client:idle slug={d.slug} name={d.name} lang={lang}/><div class="info-list">{d.experience!==null&&<span>{pick(lang,`${d.experience} years of listed experience`,`${num(lang,d.experience)} বছরের তালিকাভুক্ত অভিজ্ঞতা`)}</span>}<span>{pick(lang,`${d.chambers.length} chambers`,`${num(lang,d.chambers.length)}টি চেম্বার`)}</span></div></div><div class="profile-book"><SaveDoctor client:idle id={d.id} lang={lang}/><strong>{t(lang,'Plan Your Appointment')}</strong><p>{t(lang,'Confirm schedule and fee with the chamber.')}</p>{first?.phone&&<ReleaseLink class="btn btn-primary" href={phoneHref(first.phone)}>{t(lang,'Call Chamber')}</ReleaseLink>}<ReleaseLink class="btn btn-secondary" href="#chambers">{t(lang,'View Chambers')}</ReleaseLink></div></div></div></section>
<div class="container section profile-layout"><div class="stack">
{d.banner&&<figure class="profile-banner"><img src={d.banner} alt={pick(lang,`${d.name} — chamber information poster`,`${d.name} — চেম্বারের তথ্য`)} width="1080" height="790" loading="lazy" decoding="async"/></figure>}
<section class="content-card"><h2>{pick(lang,'About '+d.name,d.name+' সম্পর্কে')}</h2><p>{pick(lang,`${d.name} is listed under ${d.specialtySlugs.map(s=>getSpecialtyBySlug(s)?.name).filter(Boolean).join(', ')}${district?' in '+district.name:''}${d.chambers.length>1?`, with ${d.chambers.length} listed chambers`:''}.`,`${d.name}-এর ${d.specialtySlugs.map(s=>specialty(lang,getSpecialtyBySlug(s)?.name||'')).filter(Boolean).join(', ')} বিভাগে${district?' '+place(lang,district.name)+'-এ':''} তালিকাভুক্ত${d.chambers.length>1?`; চেম্বার ${num(lang,d.chambers.length)}টি`:''}।`)}</p>{d.designation&&<p>{pick(lang,'Listed designation: ','তালিকাভুক্ত পদবি: ')}{institution(lang,d.designation)}</p>}{d.qualifications&&<p>{pick(lang,'Listed qualifications: ','তালিকাভুক্ত যোগ্যতা: ')}{medicalText(lang,d.qualifications)}</p>}{d.rawSpecialties.length>0&&<><h3>{t(lang,'Specialty Details from the Listings')}</h3><p>{d.rawSpecialties.map(s=>medicalText(lang,s)).join(' · ')}</p></>}{d.registration&&<p><strong>{t(lang,'Listed BMDC registration')}: </strong><span lang="en">{d.registration}</span></p>}{d.verified?<p class="small">{pick(lang,'This profile was submitted by the doctor and is marked Verified by Doclist Bd. Confirm schedule and fees with the chamber.','এই প্রোফাইলটি ডাক্তার নিজে জমা দিয়েছেন এবং Doclist Bd-এ ভেরিফায়েড হিসেবে চিহ্নিত। সময়সূচি ও ফি চেম্বারে নিশ্চিত করুন।')}</p>:<p class="small">{t(lang,'Information reflects source listings. Professional registration and availability are not independently verified by this directory.')}</p>}</section>
<section id="chambers" class="stack"><h2>{t(lang,'Chambers & Appointment Details')}</h2>{d.chambers.map(c=><ChamberCard lang={lang} chamber={c}/>)}</section>
{faqs.length>0&&<FAQ lang={lang} items={faqs}/>}
{related.length>0&&<section><h2>{t(lang,'Related Doctor Profiles')}</h2><div class="stack">{related.map(x=><DoctorCard lang={lang} doctor={x}/>)}</div></section>}
<section class="content-card"><h2>{t(lang,'Sources & Data Notes')}</h2><p>{pick(lang,'Source observation date: ','উৎসে তথ্য পর্যবেক্ষণের তারিখ: ')}{lastChecked}। {t(lang,'This date comes from the supplied files.')}</p>{d.flags.length>0&&<p class="notice-inline">{t(lang,'One or more source records carry data quality notes. Confirm identity, schedule and other details directly with the provider.')}</p>}<ul class="source-list">{d.sources.map(u=><li><ReleaseLink href={u} target="_blank" rel="noopener noreferrer" lang="en">{u}</ReleaseLink></li>)}</ul></section>
</div><aside class="profile-sidebar"><div class="side-card"><h3>{t(lang,'Browse Nearby Doctors')}</h3><div class="stack">{d.locationSlugs.map(s=>{const l=getLocationBySlug(s);return l?<ReleaseLink href={url('/doctors/'+s)}>{pick(lang,l.name+' doctor list',place(lang,l.name)+'-এর ডাক্তার তালিকা')}</ReleaseLink>:null;})}</div></div><div class="side-card"><h3>{t(lang,'Specialty Directories')}</h3><div class="stack">{d.specialtySlugs.slice(0,6).map(s=>{const combo=district&&specialtyLocation[s+'/'+district.slug];return <ReleaseLink href={url(combo?'/doctors/'+s+'/'+district!.slug:'/specialty/'+s)}>{combo?specialtyLocationTitle(lang,getSpecialtyBySlug(s)!.name,district!.name):specialty(lang,getSpecialtyBySlug(s)?.name||'')}</ReleaseLink>;})}</div></div></aside></div>
<Schema data={{'@type':'Person',name:d.name,url:absolute(url('/doctor/'+d.slug)),...(d.designation?{jobTitle:institution(lang,d.designation)}:{}),...(d.qualifications?{description:medicalText(lang,d.qualifications)}:{}),...(d.image?{image:absolute(d.image)}:{}),worksFor:d.chambers.map(c=>({'@type':'MedicalOrganization',name:provider(lang,c.name),url:absolute(url('/hospital/'+c.hospitalSlug))}))}}/>
{d.chambers.map(c=><Schema data={{'@type':'Physician',name:d.name+' — '+provider(lang,c.name),url:absolute(url('/doctor/'+d.slug)),...(c.address?{address:{'@type':'PostalAddress',streetAddress:address(lang,c.address),addressCountry:'BD'}}:{}),...(c.phone?{telephone:c.phone}:{})}}/>)}
</Layout>
