---
import Layout from '../layouts/Layout.astro';
import PageDates from '../components/PageDates.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import HospitalCard from '../components/HospitalCard.astro';
import Pagination from '../components/Pagination.astro';
import {hospitals,pageSize} from '../../lib/directory';
import {metadata} from '../../lib/seo';
import {type Locale,t,pick,num,localizedPath} from '../../lib/i18n';

const {lang,page=1}=Astro.props as {lang:Locale;page?:number};
const meta=metadata(pick(lang,'Hospitals & Clinics in Bangladesh','বাংলাদেশের হাসপাতাল ও ক্লিনিক'),pick(lang,'Browse hospitals, clinics and diagnostic centres and their doctor lists.','হাসপাতাল, ক্লিনিক ও ডায়াগনস্টিক সেন্টারের ডাক্তার তালিকা ও যোগাযোগের তথ্য দেখুন।'),'/hospitals',{page:String(page)},lang);
const pages=Math.max(1,Math.ceil(hospitals.length/pageSize));
const path=localizedPath(lang,'/hospitals');
---
<Layout lang={lang} meta={meta}>
<PageDates path="/hospitals" lang={lang}/><section class="page-hero"><div class="container"><Breadcrumbs lang={lang} items={[{label:t(lang,'Hospitals')}]}/><h1>{pick(lang,'Hospitals & Clinics in Bangladesh','বাংলাদেশের হাসপাতাল ও ক্লিনিক')}</h1><p>{pick(lang,`Browse ${hospitals.length} listed providers and their doctor directories.`,`${num(lang,hospitals.length)}টি তালিকাভুক্ত প্রতিষ্ঠান ও তাদের ডাক্তার তালিকা দেখুন।`)}</p></div></section><section class="section"><div class="container"><div class="grid grid-3">{hospitals.slice((page-1)*pageSize,page*pageSize).map(h=><HospitalCard lang={lang} hospital={h}/>)}</div><Pagination lang={lang} path={path} query={{}} page={page} pages={pages}/></div></section>
</Layout>
