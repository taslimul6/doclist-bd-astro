{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "components/**/*", "islands/**/*", "lib/**/*", "views/**/*"],
  "exclude": ["node_modules", "dist", "migration", "scripts"]
}
