{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doclist-bd-astro",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_SITE_URL": "https://doclist-bd.com"
    // "DOCLIST_RELEASE_START": "2026-10-18"
  },
  // Engagement (love/view counters). With no database_id, wrangler creates the database on first deploy.
  "d1_databases": [
    {"binding": "DB", "database_name": "doclist-engagement", "migrations_dir": "migrations"}
  ]
}
