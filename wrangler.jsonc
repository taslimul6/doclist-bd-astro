{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doclist-bd-astro",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://doclist-bd.com"
  }
}
